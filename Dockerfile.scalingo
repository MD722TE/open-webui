# Étape de build - image temporaire pour installer les dépendances
FROM python:3.10-slim AS builder

WORKDIR /app

# Installer les dépendances système minimales
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copier uniquement le fichier requirements.txt
COPY requirements.txt .

# Installer les dépendances dans un environnement virtuel
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Étape finale - image ultra-légère
FROM python:3.10-slim

WORKDIR /app

# Copier l'environnement virtuel de l'étape de build
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copier uniquement les fichiers backend essentiels
COPY backend/main.py backend/
COPY backend/api backend/api
COPY backend/core backend/core
COPY backend/db backend/db
COPY backend/models backend/models
COPY backend/utils backend/utils
COPY backend/config.py backend/

# Définir les variables d'environnement
ENV PORT=8080
ENV HOST=0.0.0.0
ENV DATA_PATH=/app/backend/data

# Créer les répertoires nécessaires
RUN mkdir -p /app/backend/data

# Exposer le port
EXPOSE 8080

# Commande de démarrage
CMD cd backend && uvicorn main:app --host 0.0.0.0 --port $PORT
